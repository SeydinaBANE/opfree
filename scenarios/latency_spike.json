      },
      "annotations": {
        "summary": "API p99 latency above threshold",
        "description": "api-gateway p99 latency is 5.3s, exceeding the 1s SLO threshold"
      }
    },
    {
      "name": "HighErrorRate",
      "severity": "warning",
