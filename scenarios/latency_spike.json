  "runbooks": [
    {
      "name": "api-latency-spike-slow-query",
      "trigger": "APIHighLatency",
      "root_cause": "Missing database index causing full table scans on high-traffic queries",
      "steps": [
        {"action": "identify_slow_queries", "description": "Check application logs for 'Slow query' patterns and record the query text"},
        {"action": "check_query_plan", "description": "Run EXPLAIN ANALYZE <slow_query> in the database to confirm sequential scan"},
        {"action": "add_missing_index", "description": "CREATE INDEX CONCURRENTLY idx_orders_status ON orders(status); (non-blocking)"},
        {"action": "verify_index_usage", "description": "Re-run EXPLAIN ANALYZE to confirm index scan is now used"},
        {"action": "monitor_latency", "description": "Watch http_request_duration_seconds_p99 — should drop within 2 minutes of index creation"}
      ]
    }
  ],
  "gold_trajectory": [
    {"agent": "metrics_analyst", "tool": "get_alerts", "args": {}},
    {"agent": "metrics_analyst", "tool": "query_range", "args": {"metric": "http_request_duration_seconds_p99"}},
    {"agent": "metrics_analyst", "tool": "query_range", "args": {"metric": "postgres_query_duration_seconds_p99"}},
    {"agent": "log_analyst", "tool": "list_pods", "args": {"namespace": "production"}},
    {"agent": "log_analyst", "tool": "get_pod_logs", "args": {"pod_name": "api-gateway-9f2d1a-rvk3s"}},
    {"agent": "runbook_executor", "tool": "get_runbook", "args": {"trigger": "APIHighLatency"}},
    {"agent": "runbook_executor", "tool": "list_runbook_steps", "args": {"runbook_name": "api-latency-spike-slow-query"}}
  ]
}
